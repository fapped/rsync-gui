{
    "format": "rsync-gui-settings",
    "version": 1,
    "name": "Copy and verify (rsync -avhPc + checksum pass)",
    "options": {
        "archive": true,
        "recursive": true,
        "hardLinks": false,
        "acls": false,
        "xattrs": false,
        "verbose": true,
        "human": true,
        "partial": true,
        "progress": "per-file",
        "checksum": true,
        "existing": "replace",
        "compress": false,
        "contentsOnly": false,
        "deleteExtraneous": false,
        "removeSourceFiles": false,
        "dryRun": false,
        "verifyAfter": true
    }
}

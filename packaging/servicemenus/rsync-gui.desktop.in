[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;inode/directory;
X-KDE-Protocols=file,sftp
X-KDE-Submenu=Rsync
X-KDE-Priority=TopLevel
Icon=folder-sync
Actions=rsyncCopy;rsyncCopyVerify;rsyncCopyPortable;

[Desktop Action rsyncCopy]
Name=Copy…
Icon=folder-sync
Exec=@RSYNC_GUI_EXECUTABLE@ --preset rsync-copy --browse-destination %U

[Desktop Action rsyncCopyVerify]
Name=Copy and verify…
Icon=security-high
Exec=@RSYNC_GUI_EXECUTABLE@ --preset rsync-copy-verify --browse-destination %U

[Desktop Action rsyncCopyPortable]
Name=Copy to FAT/NTFS/NAS…
Icon=drive-removable-media
Exec=@RSYNC_GUI_EXECUTABLE@ --preset rsync-copy-portable --browse-destination %U
